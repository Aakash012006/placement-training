Linear Search
====================================================================
public class LinearSearch {
    public static void main(String[] args) {
        int[] arr = {3, 7, 1, 8, 5};
        int key = 8, flag = 0;
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] == key) {
                flag = 1;
                System.out.println("Found at index " + i);
                break;
            }
        }
        if (flag == 0)
            System.out.println("Not found");
    }
}
