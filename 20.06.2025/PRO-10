 Reverse a Number
======================================================================
import java.util.Scanner;

public class ReverseNumber {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int rev = 0;
        System.out.print("Enter number: ");
        int n = sc.nextInt();
        while (n != 0) {
            rev = rev * 10 + n % 10;
            n /= 10;
        }
        System.out.println("Reverse: " + rev);
    }
}
