public class Armstrong3 {
    public static void main(String[] args) {
        int num = 371, sum = 0, temp = num;
        while (temp > 0) {
            int d = temp % 10;
            sum += d * d * d;
            temp /= 10;
        }
        System.out.println(sum == num ? "Armstrong" : "Not Armstrong");
    }
}
