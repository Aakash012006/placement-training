public class RatInMaze {
    public static void solveMaze(int[][] maze) {
        int n = maze.length;
        int[][] solution = new int[n][n];
        if (backtrack(maze, 0, 0, solution)) {
            printSolution(solution);
        } else {
            System.out.println("No solution exists");
        }
    }

    private static boolean backtrack(int[][] maze, int row, int col, int[][] solution) {
        int n = maze.length;
        if (row == n - 1 && col == n - 1 && maze[row][col] == 1) {
            solution[row][col] = 1;
            return true;
        }
        if (isSafe(maze, row, col)) {
            solution[row][col] = 1;
            if (backtrack(maze, row + 1, col, solution)) return true;
            if (backtrack(maze, row, col + 1, solution)) return true;
            solution[row][col] = 0;
        }
        return false;
    }

    private static boolean isSafe(int[][] maze, int row, int col) {
        return row >= 0 && col >= 0 && row < maze.length && col < maze.length && maze[row][col] == 1;
    }

    private static void printSolution(int[][] solution) {
        for (int[] row : solution) {
            for (int cell : row) {
                System.out.print(cell + " ");
            }
            System.out.println();
        }
    }

    public static void main(String[] args) {
        int[][] maze = {
            {1, 0, 0, 0},
            {1, 1, 0, 1},
            {0, 1, 0, 0},
            {1, 1, 1, 1}
        };
        solveMaze(maze);
    }
}
