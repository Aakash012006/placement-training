public class StrongNumber {
    static int fact(int n) {
        int f = 1;
        for (int i = 1; i <= n; i++) f *= i;
        return f;
    }

    public static void main(String[] args) {
        int num = 145, sum = 0, temp = num;
        while (temp != 0) {
            sum += fact(temp % 10);
            temp /= 10;
        }
        System.out.println(sum == num ? "Strong" : "Not Strong");
    }
}
