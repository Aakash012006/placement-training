def find_pairs(lst, target):
    pairs = []
    seen = set()
    for num in lst:
        diff = target - num
        if diff in seen:
            pairs.append((num, diff))
        seen.add(num)
    return pairs

lst = [1, 2, 3, 4, 5, 6]
target = 7
print("Pairs with sum", target, ":", find_pairs(lst, target))
